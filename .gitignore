# IntelliJ. Nothing under .idea/ is tracked anywhere in this repository, so it was
# meant to be ignored and never was — it shows up as untracked noise on every status.
.idea/

# This project is Yarn PnP (packageManager: yarn@4.2.2) and has no node_modules by design.
# One `npm install` here creates 180+ directories and a package-lock.json that fight the
# committed .pnp.cjs. Ignoring node_modules stops the mess being committed; package-lock.json
# is deliberately NOT ignored, so using the wrong package manager stays visible.
node_modules/

# Build output, produced by `yarn build`.
/dist
